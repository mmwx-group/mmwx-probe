{
  "name": "mmwx-probe",
  "private": true,
  "version": "0.1.0",
  "description": "Standalone Cloudflare Worker probe frontend for MiaoMiaoWuX",
  "cloudflare": {
    "bindings": {
      "MMWX_ORIGIN": {
        "description": "\u5999\u5999\u5c4b X \u4e3b\u63a7\u7684\u516c\u7f51 HTTPS \u5730\u5740\uff0c\u4f8b\u5982 `https://panel.example.com`\u3002"
      },
      "PROBE_TOKEN": {
        "description": "\u5728\u4e3b\u63a7\u7684 **\u7cfb\u7edf\u8bbe\u7f6e \u2192 \u63a2\u9488** \u4e2d\u751f\u6210\u7684\u72ec\u7acb\u63a2\u9488\u8bbf\u95ee\u5bc6\u94a5\u3002"
      }
    }
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "deploy": "npm run build && wrangler deploy",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@simplewebauthn/browser": "^14.0.0",
    "@types/d3-geo": "^3.1.1",
    "@types/topojson-client": "^3.1.5",
    "@vitejs/plugin-react-swc": "^4.1.0",
    "d3-geo": "^3.1.1",
    "i18n-iso-countries": "^7.14.0",
    "lottie-react": "^2.4.1",
    "lucide-react": "^0.545.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "recharts": "^3.2.1",
    "simple-icons": "^16.28.0",
    "topojson-client": "^3.1.0",
    "twemoji": "^14.0.2",
    "vite": "^7.1.9",
    "world-atlas": "^2.0.2"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260731.1",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/twemoji": "^13.1.1",
    "typescript": "~5.9.3",
    "wrangler": "^4.116.0"
  },
  "overrides": {
    "postcss": {
      "nanoid": "5.1.16"
    }
  }
}
